# ==============================================================================
# Openlist-Ani-webui 环境变量配置示例
# 复制为 .env 后修改敏感配置，切勿将包含真实密码的 .env 提交到 Git 仓库
# ==============================================================================

# ── Openlist-Ani 内部服务配置（仅服务端保存，不直接暴露给浏览器）──────────────
# 与 Openlist-Ani 同机宿主机网络时通常为 http://127.0.0.1:26666
# 在 1Panel / Docker Compose 同网络下可填容器名，例如 http://openlist-ani:26666
OPENLIST_ANI_URL=http://127.0.0.1:26666

# 默认 API 请求超时时间（秒，3 ~ 300）
OPENLIST_ANI_TIMEOUT=30

# 可选：限制允许在设置页保存的上游主机白名单（英文逗号分隔，留空表示不额外限制主机名）
# 例如：WEBUI_ALLOWED_UPSTREAM_HOSTS=127.0.0.1,openlist-ani,172.17.0.1
WEBUI_ALLOWED_UPSTREAM_HOSTS=

# ── WebUI 登录认证（必须配置 WEBUI_PASSWORD 或 WEBUI_PASSWORD_HASH 之一）─────
WEBUI_USERNAME=admin

# 方式一（简单）：明文密码（请务必替换为高强度随机密码）
WEBUI_PASSWORD=change-me-to-a-strong-password

# 方式二（推荐生产使用）：scrypt 密码哈希（设置后优先于 WEBUI_PASSWORD）
# 生成命令：docker run --rm <image> python -m app.security hash-password '你的强密码'
# WEBUI_PASSWORD_HASH=

# ── 会话与安全配置 ─────────────────────────────────────────────────────────────
# 会话有效期（秒），默认 7 天 (604800)
WEBUI_SESSION_TTL_SECONDS=604800

# Cookie Secure 标志：auto（HTTPS 自动启用）/ true（强制 HTTPS）/ false（纯 HTTP）
WEBUI_COOKIE_SECURE=auto

# 若通过 1Panel OpenResty / Nginx / Caddy 反向代理暴露，请设为 true 以正确识别真实 IP 与 HTTPS
WEBUI_TRUST_PROXY=true

# 可选：额外允许的 Origin（英文逗号分隔，默认自动校验同域 Host）
WEBUI_ALLOWED_ORIGINS=

# 登录失败限流（同一 IP 在时间窗口内允许的最大失败次数）
WEBUI_LOGIN_RATE_LIMIT_MAX=5
WEBUI_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ── 界面与服务默认配置 ─────────────────────────────────────────────────────────
WEBUI_DEFAULT_POLL_INTERVAL=5
WEBUI_DEFAULT_THEME=dark
WEBUI_DEFAULT_LANGUAGE=zh-CN

# 容器监听端口与数据目录
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8080
WEBUI_DATA_DIR=/data
WEBUI_LOG_LEVEL=info
